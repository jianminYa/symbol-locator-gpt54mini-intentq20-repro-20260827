# syntax=docker/dockerfile:1

ARG BASE_IMAGE=mirrors.tencent.com/openclaw-eval/openclaw-base:openclaw-2026.7.1
FROM ${BASE_IMAGE}

USER root

COPY package.json openclaw.plugin.json index.ts api.ts \
  /root/.openclaw/extensions/symbol-locator/
COPY src/ /root/.openclaw/extensions/symbol-locator/src/
COPY skills/ /root/.openclaw/extensions/symbol-locator/skills/

RUN cd /root/.openclaw/extensions/symbol-locator \
    && npm install --omit=dev --ignore-scripts \
    && npm cache clean --force

LABEL org.openclaw.symbol-locator.source="openclaw-symbol-locator" \
      org.opencontainers.image.description="OpenClaw eval image with symbol-locator and no memory plugin"
